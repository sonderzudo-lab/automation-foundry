# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copie para .env e preencha os valores reais.
# NUNCA comite o .env com segredos reais no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infra ────────────────────────────────────────────────────────────────────

# URL do broker Redis (Celery + cache). Altere se rodar Redis em outro host/porta.
REDIS_URL=redis://127.0.0.1:6379/0

# Resultados de probes de worker são efêmeros e usam um DB Redis separado. Runs,
# steps e transições continuam persistidos exclusivamente no PostgreSQL.
CELERY_RESULT_BACKEND_URL=redis://127.0.0.1:6379/1
CELERY_SOFT_TIME_LIMIT_SECONDS=300
CELERY_HARD_TIME_LIMIT_SECONDS=330
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_RESULT_EXPIRES_SECONDS=300
CELERY_DISPATCH_LEASE_SECONDS=600
CELERY_SCHEDULE_TICK_SECONDS=30
CELERY_SCHEDULE_BATCH_SIZE=100

# PostgreSQL é o banco do runtime concorrente. Defina uma senha forte somente no
# .env local e repita o mesmo valor, com URL-encoding, em DATABASE_URL.
POSTGRES_DB=automation_foundry
POSTGRES_USER=automation_foundry
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://automation_foundry:SET_IN_LOCAL_ENV@127.0.0.1:5432/automation_foundry

# SQLite permanece disponível para testes e bootstrap de processo único:
# DATABASE_URL=sqlite+aiosqlite:///./automation_foundry.db

# Pool PostgreSQL limitado para o computador local.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=120
DATABASE_ECHO=false

# Raiz local para arquivos grandes. O banco guarda apenas metadados e caminhos relativos.
STORAGE_ROOT=./storage

# Dashboard local. O host deve ser loopback; endereços públicos são rejeitados.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
HEALTH_PROBE_TIMEOUT_SECONDS=1.5
HEALTH_WARNING_PERCENT=85
HEALTH_CRITICAL_PERCENT=95
HEALTH_ALERT_FAILURE_THRESHOLD=2
HEALTH_ALERT_RECOVERY_THRESHOLD=2
CELERY_HEALTH_TICK_SECONDS=60
RUNTIME_STARTUP_TIMEOUT_SECONDS=90
RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=30

# ── Ollama (LLM local) ───────────────────────────────────────────────────────

# Endereço do servidor Ollama rodando localmente (padrão).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Modelo a usar. Exemplos: qwen3:14b, gemma3:12b, llama3.1:8b
OLLAMA_MODEL=qwen3:14b

# Timeout em segundos para chamadas ao Ollama (modelos grandes podem demorar).
OLLAMA_TIMEOUT=120

# ── Content Engine TTS ──────────────────────────────────────────────────────

# Fail-closed: use "kokoro_quality_test" somente para avaliação audível local.
# PT-BR depende de espeak-ng externo (GPL-3.0-or-later); as três vozes não têm
# proveniência individual documentada e não estão liberadas para monetização.
CONTENT_TTS_BACKEND=disabled
CONTENT_TTS_VOICE_ID=pf_dora
CONTENT_TTS_LANGUAGE_CODE=p

# Fail-closed: FLUX.1 Schnell segue bloqueado. "local_assets_quality_test"
# importa somente PNGs escolhidos pelo operador, com SHA-256 e direitos por item
# no manifesto. O pacote visual ainda exige revisão humana antes de monetização.
CONTENT_VISUAL_BACKEND=disabled
CONTENT_VISUAL_IMPORT_ROOT=./imports/content-visuals
CONTENT_VISUAL_MANIFEST_PATH=manifest.json

# Fail-closed: "approved_text_timing_quality_test" estima timestamps usando a
# narração aprovada + duração do WAV. Não transcreve nem confirma sincronismo.
# faster-whisper/pesos continuam bloqueados até auditoria e teste local.
CONTENT_CAPTION_BACKEND=disabled

# Fail-closed: "ffmpeg_quality_test" aceita somente binários externos com hash
# exato. O build Gyan 8.0.1 abaixo é estático/GPLv3 e não deve ser vendorizado.
# O modo continua destinado a validação local até revisão humana do vídeo.
CONTENT_ASSEMBLY_BACKEND=disabled
CONTENT_FFMPEG_PATH=ffmpeg
CONTENT_FFPROBE_PATH=ffprobe
CONTENT_FFMPEG_EXPECTED_SHA256=74db6c184a03dba2bdfe23e1a1f41cf5a8385bc1de6a7a1b26db1dc541abef93
CONTENT_FFPROBE_EXPECTED_SHA256=55bb6c6289367ae2383efa86b26bf2596f8adb72ac747360eb13df162354161c

# Gate A6 local e determinístico. Score igual ou maior bloqueia a run; somente
# runs anteriores da mesma automação que já passaram pelo gate entram na janela.
CONTENT_SIMILARITY_THRESHOLD=0.85
CONTENT_SIMILARITY_WINDOW=20

# ── YouTube / Google APIs ─────────────────────────────────────────────────────

# Credenciais OAuth 2.0 do Google Cloud (baixe o client_secret.json do Console).
# Cada canal pode ter seu próprio projeto para distribuir cota de upload.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ID do projeto Google Cloud padrão (para canais sem projeto próprio).
GOOGLE_CLOUD_PROJECT_ID=

# Chave de API simples para operações de leitura (YouTube Data API v3).
# Não use para upload — use OAuth.
YOUTUBE_API_KEY=

# ── Reddit (PRAW) ─────────────────────────────────────────────────────────────

# Crie um app em https://www.reddit.com/prefs/apps (tipo "script").
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=automation-foundry/0.1 by u/SEU_USUARIO

# ── Stock de imagens/vídeo ────────────────────────────────────────────────────

# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── X / Twitter (opcional — Bloco H1) ────────────────────────────────────────

# API v2 — requer plano pago para posting.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ── Afiliados (opcional — Bloco H2) ──────────────────────────────────────────

# Amazon Associates (tag de afiliado do Brasil).
AMAZON_ASSOCIATES_TAG=

# Hotmart (se usar API de afiliados).
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=

# ── Notificações / Alertas (Bloco F1) ────────────────────────────────────────

# Webhook do Discord ou Telegram para alertas críticos.
# Discord: crie um webhook no servidor → Configurações do Canal → Integrações.
ALERT_WEBHOOK_URL=

# ── Segurança ─────────────────────────────────────────────────────────────────

# Chave de criptografia para OAuth refresh tokens guardados no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────

# Habilita upload real no TikTok (só ligue após auditar a Content Posting API).
# false = gera rascunho e pede upload manual.
TIKTOK_API_AUDITED=false

# ── Hardware / custos (Bloco E2) ──────────────────────────────────────────────

# Potência média do sistema durante inferência GPU (Watt). RTX 3090 ≈ 350W + host.
GPU_POWER_WATTS=400

# Potência média estimada do host durante montagem CPU (Watt).
CPU_POWER_WATTS=150

# Tarifa de energia elétrica local (R$/kWh). Use a sua fatura como referência.
ENERGY_TARIFF_BRL_PER_KWH=0.75

# ── Ambiente ──────────────────────────────────────────────────────────────────

# 'development' | 'production'
ENVIRONMENT=development

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
