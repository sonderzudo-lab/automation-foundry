{
  "$defs": {
    "ArtDirection": {
      "additionalProperties": false,
      "description": "How one video looks; every value is a name the render code knows.",
      "properties": {
        "palette": {
          "enum": [
            "sunny",
            "night",
            "mint",
            "coral",
            "ink",
            "candy",
            "sand"
          ],
          "title": "Palette",
          "type": "string"
        },
        "typography": {
          "enum": [
            "rounded_bold",
            "condensed_impact",
            "clean_sans",
            "serif_editorial"
          ],
          "title": "Typography",
          "type": "string"
        },
        "caption_style": {
          "enum": [
            "word_pop",
            "phrase_blocks",
            "karaoke_highlight"
          ],
          "title": "Caption Style",
          "type": "string"
        },
        "caption_position": {
          "enum": [
            "lower",
            "middle"
          ],
          "title": "Caption Position",
          "type": "string"
        },
        "motion": {
          "enum": [
            "calm",
            "lively",
            "punchy"
          ],
          "title": "Motion",
          "type": "string"
        },
        "transition": {
          "enum": [
            "crossfade",
            "slide",
            "wipe"
          ],
          "title": "Transition",
          "type": "string"
        },
        "corners": {
          "enum": [
            "rounded",
            "square"
          ],
          "title": "Corners",
          "type": "string"
        }
      },
      "required": [
        "palette",
        "typography",
        "caption_style",
        "caption_position",
        "motion",
        "transition",
        "corners"
      ],
      "title": "ArtDirection",
      "type": "object"
    },
