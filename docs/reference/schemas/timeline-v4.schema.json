    "TimelineClipV3": {
      "additionalProperties": false,
      "description": "A v2 clip that may play a video generated from its image (step A5a).\n\n``video``, ``video_sha256`` and ``video_ms`` are all set or all null. With a\nvideo the clip has no zoom (``effect`` is ``none``). The video covers the\nclip's window (``clip_window``: the clip and half of each crossfade around\nit): it starts at the window start from its first frame and plays at\n``min(1, video_ms / window length)`` speed; a longer video is cut at the end\nof the window. A video may be at most ``MAX_VIDEO_STRETCH`` times slower.",
      "properties": {
        "index": {
          "maximum": 600,
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "image": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.png$",
          "title": "Image",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "start_ms": {
          "maximum": 14400000,
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "maximum": 14400000,
          "minimum": 1,
          "title": "End Ms",
          "type": "integer"
        },
        "effect": {
          "enum": [
            "none",
            "zoom_in",
            "zoom_out",
            "pan_left",
            "pan_right"
          ],
          "title": "Effect",
          "type": "string"
        },
        "transition_in": {
          "enum": [
            "cut",
            "crossfade"
          ],
          "title": "Transition In",
          "type": "string"
        },
        "video": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.mp4$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Video"
        },
        "video_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Video Sha256"
        },
        "video_ms": {
          "anyOf": [
            {
              "maximum": 14400000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Video Ms"
        }
      },
      "required": [
        "index",
        "image",
        "image_sha256",
        "start_ms",
        "end_ms",
        "effect",
        "transition_in",
        "video",
        "video_sha256",
        "video_ms"
      ],
      "title": "TimelineClipV3",
      "type": "object"
    },
