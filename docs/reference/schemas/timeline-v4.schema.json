  "additionalProperties": false,
  "description": "Timeline v3 drawn with the moment library and one art direction.\n\nCaptions follow ``art_direction.caption_style``; clips, words, generated\nvideos and every v3 rule are unchanged.",
  "properties": {
    "schema_version": {
      "const": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "format": {
      "enum": [
        "short",
        "long"
      ],
      "title": "Format",
      "type": "string"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "fps": {
      "const": 30,
      "title": "Fps",
      "type": "integer"
    },
    "duration_ms": {
      "maximum": 14400000,
      "minimum": 1000,
      "title": "Duration Ms",
      "type": "integer"
    },
    "audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "caption_ass_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Caption Ass Sha256",
      "type": "string"
    },
    "transition_ms": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Transition Ms",
      "type": "integer"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/TimelineClipV3"
      },
      "maxItems": 600,
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/TimelineWord"
      },
      "maxItems": 60000,
      "title": "Words",
      "type": "array"
    },
    "animation_style": {
      "const": "library_v1",
      "title": "Animation Style",
      "type": "string"
    },
    "art_direction": {
      "$ref": "#/$defs/ArtDirection"
    },
    "overlays": {
      "items": {
        "discriminator": {
          "mapping": {
            "closing_sentence": "#/$defs/ClosingOverlayV4",
            "comparison": "#/$defs/ComparisonOverlay",
            "highlight": "#/$defs/HighlightOverlayV4",
            "keywords": "#/$defs/KeywordsOverlay",
            "list": "#/$defs/ListOverlayV4",
            "number": "#/$defs/NumberOverlay",
            "question": "#/$defs/QuestionOverlay",
            "quote": "#/$defs/QuoteOverlay",
            "title_card": "#/$defs/TitleCardOverlay"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TitleCardOverlay"
          },
          {
            "$ref": "#/$defs/ListOverlayV4"
          },
          {
            "$ref": "#/$defs/ComparisonOverlay"
          },
          {
            "$ref": "#/$defs/QuestionOverlay"
          },
          {
            "$ref": "#/$defs/KeywordsOverlay"
          },
          {
            "$ref": "#/$defs/NumberOverlay"
          },
          {
            "$ref": "#/$defs/HighlightOverlayV4"
          },
          {
            "$ref": "#/$defs/QuoteOverlay"
          },
          {
            "$ref": "#/$defs/ClosingOverlayV4"
          }
        ]
      },
      "maxItems": 40,
      "title": "Overlays",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "format",
    "width",
    "height",
    "fps",
    "duration_ms",
    "audio_sha256",
    "caption_ass_sha256",
    "transition_ms",
    "clips",
    "words",
    "animation_style",
    "art_direction",
    "overlays"
  ],
  "title": "TimelineV4",
  "type": "object"
}
